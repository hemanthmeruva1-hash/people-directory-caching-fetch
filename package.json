  "description": "People Directory: SSR framework, caching fetch library and demo application",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node dist/server.js",
    "typecheck": "tsc",
    "lint": "eslint .",
